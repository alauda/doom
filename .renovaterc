{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>1stG/configs"
  ],
  "ignoreDeps": [
    "@playwright/browser-chromium",
    "playwright"
  ],
  "packageRules": [
    {
      "description": "eslint-plugin-mdx 3.9.x computes whole-page diffs when a long page has remark lint messages, even without --fix (2213 s vs 12.3 s with 3.8.3 on a 128 KB page; see #373). Keep updates below 3.9.0 until upstream avoids this cost.",
      "matchPackageNames": ["eslint-plugin-mdx"],
      "allowedVersions": "<3.9.0"
    }
  ]
}
